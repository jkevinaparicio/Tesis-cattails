# Base de datos
DB_URL=jdbc:mysql://localhost:3306/coctel_db
DB_USERNAME=root
DB_PASSWORD=

# JWT
JWT_SECRET=

# OAuth2 Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini
GEMINI_API_KEY=

# Perfil activo (dev en local; en Railway/producción usar prod)
SPRING_PROFILES_ACTIVE=dev

# Frontend (usado en app.frontend-url). En dev ya trae default localhost:5173;
# en prod es obligatorio.
APP_FRONTEND_URL=http://localhost:5173

# CORS - origenes permitidos separados por coma (usado en app.allowed-origins).
# En dev ya trae default localhost:5173; en prod, la URL real de Vercel/Netlify.
APP_ALLOWED_ORIGINS=http://localhost:5173
